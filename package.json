{
  "name": "tokspot-app",
  "version": "0.4.0",
  "description": "TokSpot OPD queue — frontend + Firebase tools (rules tests, emulators, functions)",
  "private": true,
  "scripts": {
    "test": "node --test tests/",
    "test:all": "node --test tests/queue-domain.test.cjs tests/domain-sync.test.cjs tests/api-adapter.test.cjs tests/firestore-rules.test.cjs",
    "seed": "node scripts/seed-demo.js",
    "emulators": "firebase emulators:start",
    "test:rules": "node --test tests/firestore-rules.test.cjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.6.0",
    "firebase-tools": "^13.15.4"
  }
}