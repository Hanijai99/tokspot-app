rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  TokSpot Firestore rules — PROTOTYPE posture (live now)
    // ============================================================
    //  This is the ruleset the UN-MIGRATED prototype runs against
    //  (the "old permissive security posture" referenced in
    //  PRODUCTION_READINESS.md). Every page signs into Firebase
    //  first — anonymously for public flows (book, frontdesk,
    //  doctor-login, display, feedback, token, track, qr) or
    //  email/password for admin/analytics — so signed-in users
    //  may read and write tenant data.
    //
    //  SECURITY: cooperative-client posture only. No real patient
    //  data may be loaded while this ruleset is live.
    //
    //  The hardened default-deny policy is preserved verbatim in
    //  firestore.rules.target. It must be deployed ONLY TOGETHER
    //  with the Functions migration (rules + functions together,
    //  never rules alone). At that gate, point firebase.json at
    //  firestore.rules.target and deploy both in one go.
    // ============================================================

    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}